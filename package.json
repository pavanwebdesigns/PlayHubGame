{
  "name": "playhubplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check-todos && tsx scripts/check-game-content.ts && npm run catalog && tsx scripts/report-index.ts && tsx scripts/write-sitemaps.ts && next build && tsx scripts/write-sw.ts && node scripts/check-home-js.mjs",
    "catalog": "tsx scripts/build-catalog.ts",
    "lint": "eslint . --max-warnings 0 && node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "check-todos": "node --experimental-strip-types scripts/check-todos.ts"
  },
  "dependencies": {
    "lucide-react": "1.50.0",
    "minisearch": "7.2.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-vitals": "^6.2.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
